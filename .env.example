# ==========================================================================
# Task Management System — Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# ==========================================================================

# ---- Server configuration ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-management?retryWrites=true&w=majority

# ---- Auth (JWT) ----
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

# ---- Auth (Google OAuth) ----
# GOOGLE_CLIENT_ID: from Google Cloud Console — REQUIRED (checked as the audience on every
# Google ID token verification).
GOOGLE_CLIENT_ID=
# GOOGLE_ALLOWED_HD: OPTIONAL. Leave empty to allow any verified Google account found in the users
# collection (no domain restriction). If set (e.g. "dawateislami.net"), the backend enforces that the
# authenticated Google account's hosted domain matches this value, as an extra defense-in-depth layer
# on top of the users-table lookup. Never hardcode a domain in code — this is the only place it lives.
GOOGLE_ALLOWED_HD=

# ---- Google Drive (OAuth2, dedicated account) — REQUIRED ----
# A service-account JWT client has no Drive storage quota of its own (uploads fail with 403
# "Service Accounts do not have storage quota"). Instead, authenticate as a real, dedicated Google
# account (its own Drive storage backs the uploads) via a one-time-obtained OAuth2 refresh token.
# GOOGLE_DRIVE_CLIENT_ID / GOOGLE_DRIVE_CLIENT_SECRET: from a Google Cloud Console OAuth client
# (Desktop app or Web application type both work for this offline-access flow).
GOOGLE_DRIVE_CLIENT_ID=<oauth-client-id>
GOOGLE_DRIVE_CLIENT_SECRET=<oauth-client-secret>
# Obtained once via the OAuth consent flow (access_type=offline, scope
# https://www.googleapis.com/auth/drive) for the dedicated account — never expires unless revoked.
GOOGLE_DRIVE_REFRESH_TOKEN=<oauth-refresh-token>
GOOGLE_DRIVE_FOLDER_ID=<folder-id-in-the-dedicated-account-s-own-drive-for-attachments>

# ---- Email / SMTP — REQUIRED ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sending-address>
SMTP_PASS=<app-password>

# ---- App behaviour ----
# Production (Vercel) — no trailing slash:
FRONTEND_URL=https://tms-donationbox.vercel.app
# For local dev, change the above to: http://localhost:5173
# NOTE: NODE_ENV=production automatically drops the localhost:5173 CORS dev-allowance in app.js.
# NODE_ENV=development
# REMINDER_DAYS_BEFORE: how many days before a task's deadline the "deadline approaching" reminder
# fires. Configurable — never hardcode this value inside business logic.
REMINDER_DAYS_BEFORE=2
