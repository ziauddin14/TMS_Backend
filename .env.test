# Dummy, non-secret values used only by the automated test suite (NODE_ENV=test).
# Jest sets NODE_ENV=test automatically, which makes src/config/env.js load this file
# instead of a developer's real .env — so tests never depend on, or touch, real credentials.
# Safe to commit: none of these values are real.

NODE_ENV=test
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/task-management-test

JWT_SECRET=test-only-jwt-secret-do-not-use-in-real-envs
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_HD=

GOOGLE_DRIVE_CLIENT_EMAIL=test-drive-service-account@test.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\ntest-not-a-real-key\n-----END PRIVATE KEY-----
GOOGLE_DRIVE_FOLDER_ID=test-drive-folder-id

SMTP_HOST=smtp.test.local
SMTP_PORT=587
SMTP_USER=test-sender@test.local
SMTP_PASS=test-not-a-real-password

FRONTEND_URL=http://localhost:5173
REMINDER_DAYS_BEFORE=2

# Local-machine-only test convenience: this sandbox's network makes downloading Puppeteer's own
# bundled Chromium impractically slow, so tests point at the real Chrome already installed here
# instead (puppeteer's own package reads this env var automatically — no code change). This is
# NOT part of the documented architecture and must never be relied on in production: Render will
# use puppeteer's normal bundled-Chromium download, which is why this line is absent from
# .env.example. Adjust this path (or remove the line) to match whatever machine runs the tests.
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
