# Dummy, non-secret values used only by the automated test suite (NODE_ENV=test).
# Jest sets NODE_ENV=test automatically, which makes src/config/env.js load this file
# instead of a developer's real .env — so tests never depend on, or touch, real credentials.
# Safe to commit: none of these values are real.

NODE_ENV=test
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/task-management-test

JWT_SECRET=test-only-jwt-secret-do-not-use-in-real-envs
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_HD=

GOOGLE_DRIVE_CLIENT_ID=test-drive-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=test-not-a-real-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=test-not-a-real-refresh-token
GOOGLE_DRIVE_FOLDER_ID=test-drive-folder-id

SMTP_HOST=smtp.test.local
SMTP_PORT=587
SMTP_USER=test-sender@test.local
SMTP_PASS=test-not-a-real-password

FRONTEND_URL=http://localhost:5173
REMINDER_DAYS_BEFORE=2

CRON_SECRET=test-only-cron-secret-do-not-use-in-real-envs-0000

# A genuine (but test-only, throwaway) EC P-256 VAPID key pair — web-push's setVapidDetails()
# validates the key format at call time, so a hand-typed dummy string like the other test values
# above would throw. Generated once via `node -e "console.log(require('web-push').generateVAPIDKeys())"`;
# never used for any real subscription.
VAPID_PUBLIC_KEY=BBfTwnXXfFaU2tvGg7iQPzQCREWmPlgphc9cHFJPTUn8FiUC4F6zqqOzAQVyduIg0pXI0JUC2Ow-whyaGTcqsIQ
VAPID_PRIVATE_KEY=ABXyMWoesjynCCuYIIcypaPzZbp5Y-RxrvnVd3AwhDE

PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

RENDER_API_KEY=rnd_vVXtJqoSF9sB4T2qbvLpoIDg6XSt

 